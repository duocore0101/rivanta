// Prisma Schema for Rivanta Hotel Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRoleType {
  ADMIN
  RECEPTIONIST
  HOUSEKEEPING
  ACCOUNTANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING_IN_PROGRESS
  INSPECTION_REQUIRED
}

enum MaintenanceStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
}

enum StayStatus {
  ACTIVE
  COMPLETED
  EXTENDED
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

enum IdDocumentType {
  PASSPORT
  AADHAAR
  DRIVING_LICENSE
  NATIONAL_ID
  VOTER_ID
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentType {
  ADVANCE
  PARTIAL
  FINAL
  SETTLEMENT
}

enum PaymentStatus {
  SUCCESS
  REFUNDED
  PARTIALLY_REFUNDED
  VOID
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PAID
  PARTIALLY_PAID
  VOID
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  SENT
  FAILED
  PENDING
  SIMULATED_UNCONFIGURED
}

// ----------------------------------------------------
// CORE MODELS
// ----------------------------------------------------

model Hotel {
  id          String   @id @default(uuid())
  name        String
  legalName   String?
  address     String
  city        String
  state       String
  country     String   @default("India")
  postalCode  String?
  phone       String
  email       String
  website     String?
  logoUrl     String?
  timezone    String   @default("Asia/Kolkata")
  currency    String   @default("INR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                 User[]
  roles                 Role[]
  roomTypes             RoomType[]
  rooms                 Room[]
  guests                Guest[]
  reservations          Reservation[]
  stays                 Stay[]
  bookingSources        BookingSource[]
  chargeCategories      ChargeCategory[]
  serviceItems          ServiceItem[]
  invoices              Invoice[]
  payments              Payment[]
  refunds               Refund[]
  housekeepingTasks     HousekeepingTask[]
  maintenanceIssues     MaintenanceIssue[]
  auditLogs             AuditLog[]
  hotelSettings         HotelSetting[]
  taxConfigurations     TaxConfiguration[]
  declarationVersions   GuestDeclarationVersion[]
  notificationLogs      NotificationLog[]
}

model User {
  id           String       @id @default(uuid())
  hotelId      String
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRoleType @default(RECEPTIONIST)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  hotel             Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userRoles         UserRole[]
  createdStays      Stay[]             @relation("CreatedStays")
  checkedOutStays   Stay[]             @relation("CheckedOutStays")
  stayCharges       StayCharge[]
  invoices          Invoice[]
  payments          Payment[]
  approvedRefunds   Refund[]           @relation("ApprovedRefunds")
  processedRefunds  Refund[]           @relation("ProcessedRefunds")
  housekeepingTasks HousekeepingTask[]
  maintenanceIssues MaintenanceIssue[]
  auditLogs         AuditLog[]

  @@index([hotelId])
  @@index([email])
}

model Role {
  id          String   @id @default(uuid())
  hotelId     String?
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel       Hotel?           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([hotelId, name])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RoomType {
  id           String   @id @default(uuid())
  hotelId      String
  name         String
  code         String
  description  String?
  basePrice    Decimal  @db.Decimal(12, 2)
  maxOccupancy Int      @default(2)
  bedsCount    Int      @default(1)
  sizeSqFt     Int?
  amenities    String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms        Room[]
  reservations Reservation[]

  @@unique([hotelId, code])
  @@index([hotelId])
}

model Room {
  id                 String             @id @default(uuid())
  hotelId            String
  roomTypeId         String
  roomNumber         String
  floor              Int                @default(1)
  rateOverride       Decimal?           @db.Decimal(12, 2)
  status             RoomStatus         @default(AVAILABLE)
  housekeepingStatus HousekeepingStatus @default(CLEAN)
  maintenanceStatus  MaintenanceStatus  @default(OPERATIONAL)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  hotel             Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id])
  stays             Stay[]
  housekeepingTasks HousekeepingTask[]
  maintenanceIssues MaintenanceIssue[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status])
}

model Guest {
  id                    String         @id @default(uuid())
  hotelId               String
  fullName              String
  phone                 String
  email                 String?
  address               String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String         @default("India")
  nationality           String         @default("Indian")
  idType                IdDocumentType @default(AADHAAR)
  idNumber              String
  idDocumentUrl         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  isVip                 Boolean        @default(false)
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  hotel                Hotel                         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  documents            GuestDocument[]
  reservations         Reservation[]
  stays                Stay[]
  declarationAcceptances GuestDeclarationAcceptance[]

  @@index([hotelId, phone])
  @@index([hotelId, email])
  @@index([hotelId, fullName])
}

model GuestDocument {
  id           String         @id @default(uuid())
  guestId      String
  documentType IdDocumentType
  fileUrl      String
  fileName     String
  mimeType     String?
  fileSize     Int?
  createdAt    DateTime       @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
}

model BookingSource {
  id             String   @id @default(uuid())
  hotelId        String
  name           String
  code           String
  commissionRate Decimal  @default(0.0) @db.Decimal(5, 2)
  isDirect       Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  stays        Stay[]

  @@unique([hotelId, code])
  @@index([hotelId])
}

model Reservation {
  id                String            @id @default(uuid())
  hotelId           String
  guestId           String
  roomTypeId        String
  bookingSourceId   String
  reservationNumber String
  checkInDate       DateTime
  checkOutDate      DateTime
  adultsCount       Int               @default(1)
  childrenCount     Int               @default(0)
  estimatedAmount   Decimal           @db.Decimal(12, 2)
  status            ReservationStatus @default(CONFIRMED)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest         Guest         @relation(fields: [guestId], references: [id])
  roomType      RoomType      @relation(fields: [roomTypeId], references: [id])
  bookingSource BookingSource @relation(fields: [bookingSourceId], references: [id])
  stays         Stay[]

  @@unique([hotelId, reservationNumber])
  @@index([hotelId, checkInDate])
}

model Stay {
  id                      String     @id @default(uuid())
  hotelId                 String
  reservationId           String?
  guestId                 String
  roomId                  String
  bookingSourceId         String
  stayNumber              String
  checkInTime             DateTime   @default(now())
  expectedCheckOutTime    DateTime
  actualCheckOutTime      DateTime?
  adultsCount             Int        @default(1)
  childrenCount           Int        @default(0)
  totalNights             Int        @default(1)
  ratePerNight            Decimal    @db.Decimal(12, 2)
  status                  StayStatus @default(ACTIVE)
  externalBookingRef      String?
  partnerCommissionAmount Decimal?   @db.Decimal(12, 2)
  partnerCommissionStatus String?
  partnerCollectedAmount  Decimal?   @db.Decimal(12, 2)
  paymentResponsibility   String     @default("GUEST") // GUEST or PARTNER
  specialRequests         String?
  staffNotes              String?
  createdByUserId         String
  checkedOutByUserId      String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  hotel             Hotel                        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest             Guest                        @relation(fields: [guestId], references: [id])
  room              Room                         @relation(fields: [roomId], references: [id])
  reservation       Reservation?                 @relation(fields: [reservationId], references: [id])
  bookingSource     BookingSource                @relation(fields: [bookingSourceId], references: [id])
  createdByUser     User                         @relation("CreatedStays", fields: [createdByUserId], references: [id])
  checkedOutByUser  User?                        @relation("CheckedOutStays", fields: [checkedOutByUserId], references: [id])
  charges           StayCharge[]
  invoices          Invoice[]
  payments          Payment[]
  refunds           Refund[]
  housekeepingTasks HousekeepingTask[]
  declarationAcceptances GuestDeclarationAcceptance[]

  @@unique([hotelId, stayNumber])
  @@index([hotelId, status])
  @@index([hotelId, checkInTime])
  @@index([hotelId, expectedCheckOutTime])
}

model GuestDeclarationVersion {
  id            String   @id @default(uuid())
  hotelId       String
  versionNumber Int
  title         String
  content       String   @db.Text
  isActive      Boolean  @default(true)
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  hotel       Hotel                        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  acceptances GuestDeclarationAcceptance[]

  @@unique([hotelId, versionNumber])
  @@index([hotelId])
}

model GuestDeclarationAcceptance {
  id                   String   @id @default(uuid())
  stayId               String
  guestId              String
  declarationVersionId String
  accepted             Boolean  @default(true)
  signatureUrl         String   @db.Text
  signedAt             DateTime @default(now())
  signedByStaffId      String?
  ipAddress            String?
  userAgent            String?

  stay               Stay                    @relation(fields: [stayId], references: [id], onDelete: Cascade)
  guest              Guest                   @relation(fields: [guestId], references: [id])
  declarationVersion GuestDeclarationVersion @relation(fields: [declarationVersionId], references: [id])

  @@index([stayId])
  @@index([guestId])
}

model ChargeCategory {
  id             String   @id @default(uuid())
  hotelId        String
  name           String
  code           String
  taxRatePercent Decimal  @default(0.0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  serviceItems ServiceItem[]
  charges      StayCharge[]

  @@unique([hotelId, code])
  @@index([hotelId])
}

model ServiceItem {
  id         String   @id @default(uuid())
  hotelId    String
  categoryId String
  name       String
  sku        String?
  unitPrice  Decimal  @db.Decimal(12, 2)
  taxPercent Decimal  @default(0.0) @db.Decimal(5, 2)
  isAlcohol  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  hotel    Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category ChargeCategory @relation(fields: [categoryId], references: [id])
  charges  StayCharge[]

  @@index([hotelId, categoryId])
}

model StayCharge {
  id              String   @id @default(uuid())
  stayId          String
  categoryId      String
  serviceItemId   String?
  description     String
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(12, 2)
  taxPercent      Decimal  @default(0.0) @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0.0) @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0.0) @db.Decimal(12, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)
  orderReference  String?
  isVoided        Boolean  @default(false)
  voidReason      String?
  voidedByUserId  String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stay          Stay           @relation(fields: [stayId], references: [id], onDelete: Cascade)
  category      ChargeCategory @relation(fields: [categoryId], references: [id])
  serviceItem   ServiceItem?   @relation(fields: [serviceItemId], references: [id])
  createdByUser User           @relation(fields: [createdByUserId], references: [id])
  lineItems     InvoiceLineItem[]

  @@index([stayId])
  @@index([categoryId])
}

model Invoice {
  id              String        @id @default(uuid())
  hotelId         String
  stayId          String
  invoiceNumber   String
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0.0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0.0) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0.0) @db.Decimal(12, 2)
  balanceAmount   Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(FINALIZED)
  pdfUrl          String?
  finalizedAt     DateTime?
  notes           String?
  terms           String?
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hotel         Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stay          Stay              @relation(fields: [stayId], references: [id])
  createdByUser User              @relation(fields: [createdByUserId], references: [id])
  lineItems     InvoiceLineItem[]
  payments      Payment[]

  @@unique([hotelId, invoiceNumber])
  @@index([hotelId, invoiceDate])
  @@index([stayId])
}

model InvoiceLineItem {
  id             String   @id @default(uuid())
  invoiceId      String
  stayChargeId   String?
  description    String
  categoryName   String
  quantity       Int      @default(1)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0.0) @db.Decimal(12, 2)
  taxPercent     Decimal  @default(0.0) @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0.0) @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(12, 2)

  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  stayCharge StayCharge? @relation(fields: [stayChargeId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id                   String        @id @default(uuid())
  hotelId              String
  stayId               String
  invoiceId            String?
  paymentNumber        String
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod
  paymentType          PaymentType   @default(ADVANCE)
  status               PaymentStatus @default(SUCCESS)
  transactionReference String?
  notes                String?
  receivedByUserId     String
  paymentDate          DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  hotel              Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stay               Stay     @relation(fields: [stayId], references: [id])
  invoice            Invoice? @relation(fields: [invoiceId], references: [id])
  receivedByUser     User     @relation(fields: [receivedByUserId], references: [id])
  refunds            Refund[]

  @@unique([hotelId, paymentNumber])
  @@index([hotelId, paymentDate])
  @@index([stayId])
}

model Refund {
  id                   String   @id @default(uuid())
  hotelId              String
  paymentId            String
  stayId               String
  refundNumber         String
  amount               Decimal  @db.Decimal(12, 2)
  reason               String
  transactionReference String?
  approvedByUserId     String
  processedByUserId    String
  createdAt            DateTime @default(now())

  hotel           Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  payment         Payment @relation(fields: [paymentId], references: [id])
  stay            Stay    @relation(fields: [stayId], references: [id])
  approvedByUser  User    @relation("ApprovedRefunds", fields: [approvedByUserId], references: [id])
  processedByUser User    @relation("ProcessedRefunds", fields: [processedByUserId], references: [id])

  @@unique([hotelId, refundNumber])
  @@index([hotelId])
  @@index([stayId])
}

model HousekeepingTask {
  id               String             @id @default(uuid())
  hotelId          String
  roomId           String
  stayId           String?
  taskType         String             @default("TURNOVER") // TURNOVER, DAILY_CLEAN, DEEP_CLEAN, INSPECTION
  status           TaskStatus         @default(PENDING)
  priority         TaskPriority       @default(NORMAL)
  assignedToUserId String?
  notes            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  hotel          Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room           Room  @relation(fields: [roomId], references: [id])
  stay           Stay? @relation(fields: [stayId], references: [id])
  assignedToUser User? @relation(fields: [assignedToUserId], references: [id])

  @@index([hotelId, status])
  @@index([roomId])
}

model MaintenanceIssue {
  id               String            @id @default(uuid())
  hotelId          String
  roomId           String
  reportedByUserId String
  title            String
  description      String            @db.Text
  priority         TaskPriority      @default(NORMAL)
  status           TaskStatus        @default(PENDING)
  resolutionNotes  String?           @db.Text
  reportedAt       DateTime          @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  hotel          Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room           Room  @relation(fields: [roomId], references: [id])
  reportedByUser User  @relation(fields: [reportedByUserId], references: [id])

  @@index([hotelId, status])
  @@index([roomId])
}

model AuditLog {
  id         String   @id @default(uuid())
  hotelId    String
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([hotelId, createdAt])
  @@index([entityType, entityId])
}

model HotelSetting {
  id                          String   @id @default(uuid())
  hotelId                     String   @unique
  checkInTime                 String   @default("14:00")
  checkOutTime                String   @default("11:00")
  defaultTaxRate              Decimal  @default(12.0) @db.Decimal(5, 2)
  invoicePrefix               String   @default("INV-")
  allowUnpaidCheckout         Boolean  @default(false)
  currency                    String   @default("INR")
  currencySymbol              String   @default("₹")
  timezone                    String   @default("Asia/Kolkata")
  emailNotificationsEnabled   Boolean  @default(false)
  whatsAppNotificationsEnabled Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model TaxConfiguration {
  id          String   @id @default(uuid())
  hotelId     String
  name        String
  ratePercent Decimal  @db.Decimal(5, 2)
  isInclusive Boolean  @default(false)
  category    String   @default("ALL")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model NotificationLog {
  id           String              @id @default(uuid())
  hotelId      String
  stayId       String?
  recipient    String
  channel      NotificationChannel
  templateName String
  status       NotificationStatus  @default(SIMULATED_UNCONFIGURED)
  errorMessage String?
  metadata     Json?
  createdAt    DateTime            @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, channel])
}
